# Godot's regenerable import/editor/shader cache; keep source .uid files.
.godot/
# Reproducible local outputs: Windows/Android/macOS packages, visual QA PNGs,
# texture previews, performance captures, downloaded Godot and export templates.
# Keep their generators and regression cases in tools/ and tests/; record the
# reviewed results in docs/verification.md, not generated binaries in Git.
build/
artifacts/
tmp/
*.log
# Exported release archives and device install packages are delivery artifacts.
*.apk
*.aab
*.pck
# Local IDE and operating system files.
.idea/
.vscode/
.DS_Store
Thumbs.db
# Signing identities and local machine paths must never enter Git.
.env
.env.*
!.env.example
*.keystore
*.jks
*.p12
*.mobileprovision
export_credentials.cfg
local.settings.json
# Optional development-only Python / Node environments.
__pycache__/
*.pyc
.venv/
node_modules/
